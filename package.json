{
  "name": "image-to-ascii",
  "version": "0.1.0",
  "description": "A web service that converts images to ASCII art",
  "type": "module",
  "main": "src/index.js",
  "scripts": {
    "start": "node src/index.js",
    "dev": "node --watch src/index.js",
    "test": "vitest",
    "test:run": "vitest run",
    "benchmark": "node benchmarks/benchmark-adapters.js",
    "generate-fixtures": "node test/create-test-image.js",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepare": "husky"
  },
  "keywords": [
    "ascii",
    "image",
    "converter",
    "ascii-art"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@cf-wasm/photon": "^0.3.4",
    "@hono/node-server": "^1.8.0",
    "hono": "^4.0.0",
    "sharp": "^0.33.0"
  },
  "devDependencies": {
    "eslint": "^9.39.2",
    "eslint-config-prettier": "^10.1.8",
    "husky": "^9.1.7",
    "lint-staged": "^16.2.7",
    "prettier": "^3.8.1",
    "vitest": "^1.0.0"
  },
  "engines": {
    "node": ">=20.17.0"
  },
  "lint-staged": {
    "*.js": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md}": [
      "prettier --write"
    ]
  }
}
